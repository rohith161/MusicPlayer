<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_galaxy"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/playerClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close player"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/mp_foreground" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="@color/mp_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/playerMediaOutputButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_output"
            app:mediaRouteButtonTint="@color/mp_foreground" />
    </LinearLayout>

    <TextView
        android:id="@+id/playerArtwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_now_playing_art"
        android:elevation="5dp"
        android:gravity="center"
        android:text="♫"
        android:textColor="@color/mp_accent"
        android:textSize="88sp" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/mp_foreground"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/playerArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/mp_foreground_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/playerElapsed"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/mp_foreground_muted"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/playerProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="@color/mp_primary"
            android:thumbTint="@color/mp_accent" />
        <TextView
            android:id="@+id/playerDuration"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--:--"
            android:textColor="@color/mp_foreground_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:gravity="center">
        <ImageButton
            android:id="@+id/playerShuffle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle off"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/mp_foreground" />
        <ImageButton
            android:id="@+id/playerRepeat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat off"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/mp_foreground" />
        <TextView
            android:id="@+id/playerSpeed"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="1.0×"
            android:textColor="@color/mp_foreground"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_card" />
        <TextView
            android:id="@+id/playerSleep"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="SLEEP"
            android:textColor="@color/mp_foreground"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_card" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="2dp"
        android:gravity="center">
        <ImageButton
            android:id="@+id/playerPrevious"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/mp_foreground" />
        <ImageButton
            android:id="@+id/playerPlay"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="Play or pause"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/mp_primary_foreground" />
        <ImageButton
            android:id="@+id/playerNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/mp_foreground" />
    </LinearLayout>
</LinearLayout>
