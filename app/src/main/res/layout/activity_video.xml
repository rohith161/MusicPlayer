<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/videoControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#66000000">
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/videoOutputButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Media output"
            android:padding="10dp"
            app:mediaRouteButtonTint="#FFFFFF" />
        <Button
            android:id="@+id/videoSpeedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="56dp"
            android:text="1×"
            android:textColor="#FFFFFF"
            android:backgroundTint="#66000000" />
        <Button
            android:id="@+id/videoFullscreenButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="56dp"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:backgroundTint="#66000000" />
        <Button
            android:id="@+id/videoLockButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="56dp"
            android:text="🔓"
            android:textColor="#FFFFFF"
            android:backgroundTint="#66000000" />
    </LinearLayout>

    <TextView
        android:id="@+id/videoGestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="#66000000"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
