<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/videoPlayerView" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true" app:controller_show_timeout="2000" />

    <FrameLayout android:id="@+id/videoControlsOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:background="#55000000" android:gravity="end|center_vertical" android:orientation="horizontal" android:padding="8dp">
            <androidx.mediarouter.app.MediaRouteButton android:id="@+id/videoOutputButton" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Media output" android:padding="8dp" app:mediaRouteButtonTint="#FFFFFF" />
            <Button android:id="@+id/videoSubtitleButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="50dp" android:text="CC" android:textColor="#FFFFFF" android:backgroundTint="#33000000" />
            <Button android:id="@+id/videoAudioButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="60dp" android:text="Audio" android:textColor="#FFFFFF" android:backgroundTint="#33000000" />
            <Button android:id="@+id/videoSpeedButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="50dp" android:text="1×" android:textColor="#FFFFFF" android:backgroundTint="#33000000" />
            <Button android:id="@+id/videoFullscreenButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="50dp" android:text="⛶" android:textColor="#FFFFFF" android:backgroundTint="#33000000" />
        </LinearLayout>
        <Button android:id="@+id/videoLockButton" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="bottom|start" android:layout_marginStart="14dp" android:layout_marginBottom="18dp" android:text="🔓" android:textColor="#FFFFFF" android:backgroundTint="#44000000" />
    </FrameLayout>

    <LinearLayout android:id="@+id/videoSpeedIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="76dp" android:background="#55000000" android:gravity="center" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="8dp" android:paddingEnd="18dp" android:paddingBottom="10dp" android:visibility="gone">
        <TextView android:id="@+id/videoSpeedDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.35" android:text="○ ○ ○ ○" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/videoSpeedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="1×" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/videoGestureHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="#55000000" android:padding="12dp" android:textColor="#FFFFFF" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
